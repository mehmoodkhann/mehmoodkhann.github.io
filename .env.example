# Demo editor only. VITE_* values are public in the browser build.
# Keep the source .env private; never use a real account password here.
VITE_ADMIN_PASSWORD=demo-admin

# Reserved for a future backend; the current content services use browser storage.
VITE_API_BASE_URL=

# Existing EmailJS integration. Template variables: from_name, from_email, message.
# Empty values produce a clearly labelled local draft, not an email confirmation.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Real public origin, for example your own https:// domain.
# Leave empty until confirmed. A build with this value produces canonicals and a sitemap.
VITE_SITE_URL=
